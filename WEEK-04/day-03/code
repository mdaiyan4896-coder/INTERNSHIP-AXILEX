import sqlite3

conn = sqlite3.connect("data.db")
cursor = conn.cursor()

# Create table (if not exists)
cursor.execute("""
CREATE TABLE IF NOT EXISTS students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT,
    usn TEXT
)
""")

# INSERT
cursor.execute("INSERT INTO students (name, usn) VALUES (?, ?)", ("Rahul", "123"))

# UPDATE
cursor.execute("UPDATE students SET name=? WHERE usn=?", ("Aiyan Updated", "2JH25CS068"))

# DELETE
cursor.execute("DELETE FROM students WHERE usn=?", ("123",))

# SELECT
cursor.execute("SELECT * FROM students")
rows = cursor.fetchall()

print("Final Records:")
for row in rows:
    print(row)

conn.commit()
conn.close()
